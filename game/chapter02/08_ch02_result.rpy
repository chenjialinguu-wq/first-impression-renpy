label ch02_result:

    scene bg_netherfield_evening_library
    with fade

    n "第二章结算"
    n "尼日斐花园没有舞会那样热闹，却有另一种更安静的审判。"

    if jane_health_care >= 4:
        n "章节评价：简的守护者"
        n "你将姐姐的安危置于社交评价之上。简会更信任你，也更愿意向你透露她对宾利的真实感受。"

    elif insight >= 7:
        n "章节评价：清醒的观察者"
        n "你看见了礼貌之下的竞争、赞美之下的审视。后续你将更早察觉卡罗琳和达西之间的微妙错位。"

    elif pride >= 6 and caroline_rivalry >= 3:
        n "章节评价：客厅里的反击者"
        n "你没有被尼日斐的优雅规则压制。但卡罗琳已经开始把你视为威胁。"

    elif class_pressure >= 4:
        n "章节评价：被阶级注视的人"
        n "你意识到尼日斐花园的客厅比舞会更难穿行。每一处礼貌都可能是一种审查。"

    elif darcy_attention >= 4:
        n "章节评价：达西的疑问"
        n "达西开始无法用最初的判断解释你。你的行动和言辞，让他的冷淡出现了细微裂缝。"

    else:
        n "章节评价：尼日斐的访客"
        n "你照顾了简，也走进了一个更讲究、更冷静、更善于评价人的空间。"

    n "下一章预告：梅里屯街谈。"
    n "一位年轻军官即将登场。他的故事，会比达西先生的沉默更容易使人相信。"

    menu:
        "第二章试玩结束。"

        "返回标题":
            return

        "重新开始第二章":
            jump chapter_02_start
